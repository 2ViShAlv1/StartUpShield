venv/
.venv/
__pycache__/
*.pyc
# data/raw/*.csv is intentionally NOT ignored: the demo CSVs are small, plain
# text, and version-proof, so they ship with the repo as the reproducible seed a
# fresh deploy trains from. Models stay ignored -- pickles are fragile across
# library versions, so they are rebuilt in the deployment environment instead.
data/processed/*.csv
train.csv
test_.csv
archive*.zip
models/*.pkl
models/sentiment_model/
reports/train_summary.json
.env
.streamlit/secrets.toml
*.log
# Rendered from the tracked docs/*.md sources, so it would go stale on every edit.
docs/*.pdf
.pytest_cache/
.ipynb_checkpoints/
